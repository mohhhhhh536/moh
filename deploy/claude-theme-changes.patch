+  flex: 0 0 auto;
+  font-size: 1.4rem;
+  font-weight: 600;
+  line-height: 1.3;
+  text-decoration: line-through;
+  opacity: 0.7;
+}
+.quantity-breaks-container input:checked + .quantity-break .quantity-break__gift {
+  background: var(--qb-accent);
+  color: #fff;
+}
+.quantity-breaks-container input:checked + .quantity-break .quantity-break__gift-value {
+  opacity: 0.85;
+}
+
+/* ---- auto-ship ---- */
+.quantity-breaks__autoship {
+  margin-top: 1.2rem;
+  border: 0.2rem dashed var(--qb-accent);
+  border-radius: var(--qb-radius);
+}
+.quantity-breaks__autoship-input {
+  position: absolute;
+  opacity: 0;
+  width: 0;
+  height: 0;
+}
+.quantity-breaks__autoship-label {
+  display: flex;
+  align-items: center;
+  column-gap: 1.3rem;
+  padding: 1.4rem var(--qb-pad-x);
+  cursor: pointer;
+  margin: 0;
+}
+.quantity-breaks__autoship-box {
+  flex: 0 0 auto;
+  width: 2.4rem;
+  height: 2.4rem;
+  border: 0.2rem solid var(--qb-accent);
+  border-radius: 0.4rem;
+  background: rgb(var(--color-background));
+  color: var(--qb-accent);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+.quantity-breaks__autoship-box svg {
   width: 1.5rem;
   height: 1.5rem;
-  position: absolute;
-  left: 2rem;
-  top: 50%;
-  transform: translate(-50%, -50%);
-  border-radius: 50%;
-  border: solid 0.2rem rgba(var(--accent-color), 0.3);
+  opacity: 0;
+  transition: opacity 0.12s ease;
 }
-.quantity-breaks-container input:checked + .quantity-break::before {
-  border: solid 0.2rem rgb(var(--color-background));
-  background: rgb(var(--accent-color));
-  box-shadow: 0 0 0 0.1rem rgb(var(--accent-color));
+.quantity-breaks__autoship-input:checked
+  + .quantity-breaks__autoship-label
+  .quantity-breaks__autoship-box
+  svg {
+  opacity: 1;
+}
+.quantity-breaks__autoship-input:focus-visible
+  + .quantity-breaks__autoship-label
+  .quantity-breaks__autoship-box {
+  outline: 0.2rem solid var(--qb-accent);
+  outline-offset: 0.2rem;
+}
+.quantity-breaks__autoship-copy {
+  display: flex;
+  flex-direction: column;
+  row-gap: 0.2rem;
+}
+.quantity-breaks__autoship-title {
+  font-size: 1.6rem;
+  font-weight: 800;
+  line-height: 1.25;
+}
+.quantity-breaks__autoship-subtitle {
+  font-size: 1.35rem;
+  line-height: 1.3;
+  color: var(--qb-muted);
+}
+
+/* ---- variant selectors sit inside the padded card ---- */
+.quantity-break__variants {
+  padding-left: var(--qb-pad-x);
+  padding-right: var(--qb-pad-x);
+}
+.quantity-breaks-container
+  input:checked
+  + .quantity-break
+  .quantity-break__variants {
+  padding-bottom: 1.4rem;
+}
+
+@media screen and (max-width: 480px) {
+  quantity-breaks {
+    --qb-pad-x: 1.3rem;
+  }
+  .quantity-break__content {
+    column-gap: 1rem;
+    padding-top: 1.2rem;
+    padding-bottom: 1.2rem;
+  }
+  .quantity-break__media {
+    width: 3.6rem;
+  }
+  .quantity-break__left .quantity-break__label {
+    font-size: 1.8rem;
+  }
+  .quantity-break__price {
+    font-size: 2rem;
+  }
+  .quantity-break__compare-price,
+  .quantity-break__caption {
+    font-size: 1.3rem;
+  }
+  .quantity-break__gift-text {
+    font-size: 1.35rem;
+  }
+  .quantity-breaks__title {
+    font-size: 1.35rem;
+    column-gap: 0.9rem;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .quantity-break,
+  .quantity-break__gift,
+  .quantity-breaks__autoship-box svg {
+    transition: none;
+  }
