                >
                  <span class="quantity-break__selector-item__number">#{{ selectorItem }}</span>
                  {%- for option in product.options_with_values -%}
                    <div class="select select--small">
                      <select
                        class="quantity-break__variant-select select__select variant-dropdown"
                        name="options[{{ option.name | escape }}]"
                        data-product-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- liquid
                          assign variants_available_arr = product.variants | map: 'available'
                          assign variants_option1_arr = product.variants | map: 'option1'
                          assign variants_option2_arr = product.variants | map: 'option2'
                          assign variants_option3_arr = product.variants | map: 'option3'
                        -%}
                        {% for value in option.values %}
                          {%- liquid
                            assign option_disabled = true

                            for option1_name in variants_option1_arr
                              case option.position
                                when 1
                                  if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                                when 2
                                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                                when 3
                                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                              endcase
                            endfor
                          -%}
                          <option
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}
                              selected="selected"
                            {% endif %}
                          >
                            {% if option_disabled -%}
                              {{- 'products.product.value_unavailable' | t: option_value: value -}}
                            {%- else -%}
                              {{- value -}}
                            {%- endif %}
                          </option>
                        {% endfor %}
                      </select>
                      {% render 'ds-icon-caret' %}
                    </div>
                  {%- endfor -%}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
        {% if block.settings.show_addon_row %}
          <span class="quantity-break__addon">
            <span class="quantity-break__addon-icon">
              {%- if block.settings.addon_icon != blank -%}
                <img src="{{ block.settings.addon_icon | image_url: width: 80 }}" alt="" loading="lazy" width="auto" height="auto">
              {%- endif -%}
            </span>
            <span class="quantity-break__addon-label">{{ block.settings.addon_label | escape }}</span>
            {%- if block.settings.addon_price != blank -%}
              <span class="quantity-break__addon-price">{{ block.settings.addon_price | escape }}</span>
            {%- endif -%}
          </span>
        {% endif %}
      </label>
    {% endif %}
    {% if block.settings.option_4_quantity != 0 %}
      {% liquid
        assign option_4_override_variant = nil
        if block.settings.option_4_variant_id != blank
          assign option_4_override_id = block.settings.option_4_variant_id | plus: 0
          for v in product.variants
            if v.id == option_4_override_id
              assign option_4_override_variant = v
              break
            endif
          endfor
        endif

        assign percentage_discount = block.settings.option_4_percentage_off_text | plus: 0
        assign percentage_left = 100 | minus: percentage_discount | divided_by: 100.00
        assign fixed_amount_off = block.settings.option_4_fixed_amount_off | times: 100
        assign option_4_price = price | times: block.settings.option_4_quantity | times: percentage_left | minus: fixed_amount_off

        assign compare_price = price
        if block.settings.option_4_compare_price == 'compare_price' and product.selected_or_first_available_variant.compare_at_price > price
          assign compare_price = product.selected_or_first_available_variant.compare_at_price
        endif
        assign option_4_compare_price = compare_price | times: block.settings.option_4_quantity

        assign option_4_quantity_value = block.settings.option_4_quantity
        if option_4_override_variant
          assign option_4_price = option_4_override_variant.price
          assign option_4_compare_price = option_4_override_variant.compare_at_price
          if option_4_compare_price <= option_4_price
            assign option_4_compare_price = option_4_price
          endif
          assign option_4_quantity_value = 1
        endif

        assign option_4_price_difference = option_4_compare_price | minus: option_4_price
        assign option_4_price_difference_rounded = option_4_price_difference | divided_by: 100.00 | round | times: 100
      %}
      <input
        id="quantity4"
        aria-label="Quantity"
        type="radio"
        name="quantity"
        value="{{ option_4_quantity_value }}"
        form="{{ product_form_id }}"
        {% if block.settings.preselected == 'option_4' %}
          checked
        {% endif %}
        data-input="input_4"
        data-override-variant-id="{{ option_4_override_variant.id }}"
      >
      <label
        for="quantity4"
        class="quantity-break{% if block.settings.highlight_option == 'option_4' %} quantity-break--best-value{% endif %}"
        data-quantity="{{ block.settings.option_4_quantity }}"
        data-input="input_4"
        data-percentage-left="{{ percentage_left }}"
        data-fixed-discount="{{ fixed_amount_off }}"
      >
        {% if block.settings.display_badge == 'option_4' %}
          <p class="quantity-break__badge">
            {{ block.settings.badge_text }}
          </p>
        {% endif %}
        {% if block.settings.display_badge_2 == 'option_4' %}
          <p class="quantity-break__badge quantity-break__badge--secondary">
            {{ block.settings.badge_text_2 }}
          </p>
        {% endif %}
        <div class="quantity-break__content">
          <span class="quantity-break__media">
            {%- if product.featured_image != blank -%}
              {%- for i in (1..block.settings.option_4_quantity) -%}
                <span class="quantity-break__media-icon quantity-break__media-icon--photo">
                  <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="auto" height="auto">
                </span>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..block.settings.option_4_quantity) -%}
                <span class="quantity-break__media-icon">{%- render 'ds-icon-accordion', icon: 'bottle' -%}</span>
              {%- endfor -%}
            {%- endif -%}
          </span>
          <div class="quantity-break__left">
            <span class="quantity-break__label">
              <span class="quantity-break__label-text">
                {%- if block.settings.option_4_label != blank -%}
                  {{ block.settings.option_4_label }}
                {%- else -%}
                  Buy {{ block.settings.option_4_quantity }}
                {%- endif -%}
              </span>
              {% if block.settings.option_4_benefit != blank %}
                <span class="quantity-break__benefit">{{ block.settings.option_4_benefit }}</span>
              {% endif %}
            </span>
            {% if block.settings.option_4_caption != blank %}
              <span class="quantity-break__caption variant-money-change variant-price-update" data-text="{{ block.settings.option_4_caption }}">
                {% capture amount_saved_money %}{{ option_4_price_difference | money_without_trailing_zeros }}{% endcapture %}
                {% capture amount_saved_rounded_money %}{{ option_4_price_difference_rounded | money_without_trailing_zeros }}{% endcapture %}
                {{ block.settings.option_4_caption | replace: '[amount_saved]', amount_saved_money | replace: '[amount_saved_rounded]', amount_saved_rounded_money }}
              </span>
            {% endif %}
          </div>
          <div class="quantity-break__right variant-money-change">
            <span class="quantity-break__price variant-price-update" data-text="[price]">
              {{ option_4_price | money_without_trailing_zeros }}
            </span>
            <span class="quantity-break__compare-price variant-price-update" data-text="[compare_price]">{% if option_4_compare_price > option_4_price %}{{ option_4_compare_price | money_without_trailing_zeros }}{% endif %}</span>
          </div>
        </div>
        {% if product.has_only_default_variant == false and block.settings.enable_variant_selectors %}
          {% if block.settings.option_4_quantity != 1 or block.settings.enable_variant_selectors_on_quantity_of_1 %}
            <div class="quantity-break__variants" id='option-4-variants-{{ section.id }}'>
              {% assign has_variants = true %}
              {% for selectorItem in (1..block.settings.option_4_quantity) %}
                <div
                  class="quantity-break__selector-item"
                  data-select-index="{{ forloop.index0 }}"
                  data-selected-id="{{ product.selected_or_first_available_variant.id }}"
                >
                  <span class="quantity-break__selector-item__number">#{{ selectorItem }}</span>
                  {%- for option in product.options_with_values -%}
                    <div class="select select--small">
                      <select
                        class="quantity-break__variant-select select__select variant-dropdown"
                        name="options[{{ option.name | escape }}]"
                        data-product-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- liquid
                          assign variants_available_arr = product.variants | map: 'available'
                          assign variants_option1_arr = product.variants | map: 'option1'
                          assign variants_option2_arr = product.variants | map: 'option2'
                          assign variants_option3_arr = product.variants | map: 'option3'
                        -%}
                        {% for value in option.values %}
                          {%- liquid
                            assign option_disabled = true

                            for option1_name in variants_option1_arr
                              case option.position
                                when 1
                                  if variants_option1_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                                when 2
                                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                                when 3
                                  if option1_name == product.selected_or_first_available_variant.option1 and variants_option2_arr[forloop.index0] == product.selected_or_first_available_variant.option2 and variants_option3_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                                    assign option_disabled = false
                                  endif
                              endcase
                            endfor
                          -%}
                          <option
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}
                              selected="selected"
                            {% endif %}
                          >
                            {% if option_disabled -%}
                              {{- 'products.product.value_unavailable' | t: option_value: value -}}
                            {%- else -%}
                              {{- value -}}
                            {%- endif %}
                          </option>
                        {% endfor %}
                      </select>
                      {% render 'ds-icon-caret' %}
                    </div>
                  {%- endfor -%}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
        {% if block.settings.show_addon_row %}
          <span class="quantity-break__addon">
            <span class="quantity-break__addon-icon">
              {%- if block.settings.addon_icon != blank -%}
                <img src="{{ block.settings.addon_icon | image_url: width: 80 }}" alt="" loading="lazy" width="auto" height="auto">
              {%- endif -%}
            </span>
            <span class="quantity-break__addon-label">{{ block.settings.addon_label | escape }}</span>
            {%- if block.settings.addon_price != blank -%}
              <span class="quantity-break__addon-price">{{ block.settings.addon_price | escape }}</span>
            {%- endif -%}
          </span>
        {% endif %}
      </label>
    {% endif %}
  </div>

  {%- if block.settings.show_autoship -%}
    <label class="quantity-breaks__autoship">
      <input
        type="checkbox"
        class="quantity-breaks__autoship-checkbox"
        {% if block.settings.autoship_default_checked %}
          checked
        {% endif %}
      >
      <span class="quantity-breaks__autoship-check">
        <svg viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 6L5.5 10.5L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="quantity-breaks__autoship-info">
        <span class="quantity-breaks__autoship-title">{{ block.settings.autoship_title | escape }}</span>
        <span class="quantity-breaks__autoship-subtitle">{{ block.settings.autoship_subtitle | escape }}</span>
      </span>
      <span class="quantity-breaks__autoship-toggle" aria-hidden="true"></span>
    </label>
  {%- endif -%}

  <script data-has-variants="{{ has_variants }}" type="application/json">
    {{ product.variants | json }}
  </script>
</quantity-breaks>
