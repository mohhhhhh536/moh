{%- comment -%}
  Renders a 5-star rating row.

  Accepts:
  - rating: {Number} Rating out of 5. Default: 5
  - color: {String} Fill colour of the earned stars. Default: #E0A100
  - size: {Number} Star size in px. Default: 14
  - label: {String} Optional text shown after the stars, e.g. "(128 reviews)"

  Usage:
  {% render 'thessvane-stars', rating: 4.8, color: '#E0A100', size: 14 %}
{%- endcomment -%}

{%- liquid
  assign star_rating = rating | default: 5
  if star_rating > 5
    assign star_rating = 5
  endif
  if star_rating < 0
    assign star_rating = 0
  endif
  assign star_percent = star_rating | times: 20.0
  assign star_color = color | default: '#E0A100'
  assign star_size = size | default: 14
-%}

<span
  class="tv-stars"
  style="--tv-star-color: {{ star_color }}; --tv-star-size: {{ star_size }}px;"
  role="img"
  aria-label="{{ star_rating }} {{ 'accessibility.star_reviews_info' | t: rating_max: 5 | default: 'out of 5 stars' }}"
>
  <span class="tv-stars__row" aria-hidden="true">
    <span class="tv-stars__track">
      {%- for i in (1..5) -%}
        <svg class="tv-stars__star" viewBox="0 0 576 512" fill="currentColor" focusable="false"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>
      {%- endfor -%}
    </span>
    <span class="tv-stars__fill" style="width: {{ star_percent }}%;">
      {%- for i in (1..5) -%}
        <svg class="tv-stars__star" viewBox="0 0 576 512" fill="currentColor" focusable="false"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>
      {%- endfor -%}
    </span>
  </span>
  {%- if label != blank -%}
    <span class="tv-stars__label">{{ label }}</span>
  {%- endif -%}
</span>
