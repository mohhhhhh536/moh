akes Up My Eyes!","text":"<h5><br/>This product stood out because of how easy it is to use. My eyes look noticeably more refreshed since adding it to my routine. I'd definitely repurchase.<br/><br/></h5>","author":"Tina M."}}},"block_order":["column_YyHMKP","column_ENbtbz","column_Xj89MC"],"settings":{"title":"Our Clients Say","heading_size":"h2","text":"","image_width":"full","image_ratio":"square","columns_desktop":3,"slider_preview":true,"column_alignment":"center","show_stars":false,"stars_color":"#ffd700","show_quotes":false,"quotes_color_scheme":"background-1","background_style":"primary","color_scheme":"background-1","padding_top":36,"padding_bottom":36,"custom_colors_background":"#ffffff","custom_gradient_background":"","custom_colors_text":"#121212"}},"wd_section_divider_bUhFHB":{"type":"wd-section-divider","settings":{"divider_shape":"diagonal","divider_color_top":"#ffffff","divider_color_bottom":"#000000","padding_top_desktop":40,"padding_bottom_desktop":40,"padding_top_mobile":40,"padding_bottom_mobile":40,"margin_top":0,"margin_bottom":0,"max_height_desktop":100,"max_height_mobile":100}},"ingredient_callout":{"type":"thessvane-ingredient-callout","settings":{"layout":"image_first","eyebrow":"Why This Formula","heading":"Brighter, More Even Eyes.","heading_size":"h1","text":"<p>Our Calcium Dark Spot Eye Cream is formulated to help target the look of dark spots and uneven tone around the eyes, while hydrating ingredients support smoother, more refreshed-looking skin.</p>","button_label":"","button_style_secondary":false,"section_color_scheme":"scheme-1","color_scheme":"scheme-1","padding_top":36,"padding_bottom":36}},"results_section":{"type":"results","blocks":{"row_1":{"type":"row","settings":{"percentage":91,"row_text":"<p>Saw dark spots looking less noticeable</p>"}},"row_2":{"type":"row","settings":{"percentage":87,"row_text":"<p>Noticed a more even under-eye tone</p>"}},"row_3":{"type":"row","settings":{"percentage":90,"row_text":"<p>Said it layered