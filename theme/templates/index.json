    "thessvane_reviews": {
      "type": "thessvane-reviews",
      "blocks": {
        "eyebrow_rev": {
          "type": "eyebrow",
          "settings": {
            "text": "Real Results"
          }
        },
        "heading_rev": {
          "type": "heading",
          "settings": {
            "heading": "What Our Customers Are Saying"
          }
        },
        "review_1": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I have really sensitive, easily irritated skin, so I was nervous trying something new. Within the first week my redness had calmed down, and by week three my skin looked genuinely brighter \u2014 no breakouts, no stinging, just a routine that finally works for me.",
            "name": "Maya R.",
            "badge": "Verified Customer"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I've spent years testing 'clean' skincare brands that still left my skin red and broken out. Thessvane is the first one where I can actually read every ingredient on the label \u2014 and my skin has never felt calmer. It's become the one step in my routine I never skip.",
            "name": "Priya K.",
            "badge": "Verified Customer"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "What sold me was how simple the routine is \u2014 three products, five minutes, no eleven-step process to keep up with. Two months in, my skin tone is more even and it actually feels hydrated instead of just coated in product. This is what clean ingredients should have felt like from the start.",
            "name": "Jordan L.",
            "badge": "Verified Customer"
          }
        }
      },
      "block_order": [
        "eyebrow_rev",
        "heading_rev",
        "review_1",
        "review_2",
        "review_3"
      ],
