          "type": "collapsible_row",
          "settings": {
            "heading": "How long until I see results?",
            "icon": "stopwatch",
            "row_content": "<p>Most people notice softer, more hydrated skin within the first week. Changes in tone and texture build over four to six weeks of consistent twice-daily use.</p>",
            "page": ""
          }
