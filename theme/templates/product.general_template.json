    "thessvane_how_to_use": {
      "type": "thessvane-how-to-use",
      "blocks": {
        "step_cleanse": {
          "type": "step",
          "settings": {
            "step_title": "Cleanse",
            "step_text": "<p>Start on clean, damp skin — straight out of the shower is ideal.</p>",
            "step_note": "Warm water, not hot."
          }
        },
        "step_apply": {
          "type": "step",
          "settings": {
            "step_title": "Apply",
            "step_text": "<p>Massage a pea-sized amount over the area in slow circles until it disappears.</p>",
            "step_note": "A little goes further on damp skin."
          }
        },
        "step_absorb": {
          "type": "step",
          "settings": {
            "step_title": "Let It Settle",
            "step_text": "<p>Give it about sixty seconds to sink in before layering anything on top.</p>",
            "step_note": "No need to rinse it off."
          }
        },
        "step_repeat": {
          "type": "step",
          "settings": {
            "step_title": "Repeat Daily",
            "step_text": "<p>Once a day, every day. Consistency does more here than quantity ever will.</p>",
            "step_note": "Evenings suit most routines best."
          }
        }
      },
      "block_order": [
        "step_cleanse",
        "step_apply",
        "step_absorb",
        "step_repeat"
      ],
      "settings": {
        "title": "4 Steps To Use It",
        "heading_size": "h1",
        "description": "<p>Four steps, about a minute. It works into a morning or evening routine without rearranging anything else.</p>",
        "color_scheme": "scheme-2",
        "columns_desktop": 4,
