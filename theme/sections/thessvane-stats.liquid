{{ 'section-thessvane-stats.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="thessvane-stats color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="thessvane-stats__inner page-width">
    {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
    {%- if stat_blocks.size > 0 -%}
      <div class="thessvane-stats__row thessvane-stats__row--{{ stat_blocks.size }}">
        {%- for block in stat_blocks -%}
          <div class="thessvane-stats__item" {{ block.shopify_attributes }}>
            <span class="thessvane-stats__num">{{ block.settings.number | escape }}</span>
            <span class="thessvane-stats__lbl">{{ block.settings.label | escape }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_placeholder_flag -%}
      <p class="thessvane-stats__flag">Placeholder numbers — replace with your real data before launch</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Thessvane Stats",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Store stat callouts (orders, ratings, etc). Defaults are placeholders — edit them with your real numbers before launch, and turn off the on-page reminder flag once you have."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder_flag",
      "default": true,
      "label": "Show \"placeholder\" reminder text",
      "info": "A small on-page note reminding you these numbers aren't real yet. Turn off once you've updated them."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "1,000+",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Rituals Started",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thessvane Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "1,000+", "label": "Rituals Started" } },
        { "type": "stat", "settings": { "number": "4.9★", "label": "Average Rating" } },
        { "type": "stat", "settings": { "number": "100%", "label": "Cruelty-Free" } },
        { "type": "stat", "settings": { "number": "3", "label": "Core Ingredients" } }
      ]
    }
  ]
}
{% endschema %}
