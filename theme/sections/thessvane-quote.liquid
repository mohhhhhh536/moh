{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .quote-{{ section.id }} .quote__inner {
    max-width: {{ section.settings.max_width }}rem;
    margin: 0 auto;
    text-align: center;
  }
  .quote-{{ section.id }} .quote__mark {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 6rem;
    line-height: 0.6;
    margin: 0 0 1.6rem;
    opacity: 0.3;
  }
  .quote-{{ section.id }} .quote__text {
    font-family: var(--font-heading-family);
    font-style: italic;
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.02rem;
    line-height: 1.35;
    margin: 0;
    text-wrap: balance;
  }
  .quote-{{ section.id }} .quote__attribution {
    margin: 2.4rem 0 0;
  }
  .quote-{{ section.id }} .quote__attribution-rule {
    display: block;
    width: 4rem;
    height: 0.1rem;
    margin: 0 auto 1.6rem;
    background-color: rgba(var(--color-foreground), 0.35);
    border: 0;
  }
  .quote-{{ section.id }} .quote__author {
    display: block;
    margin: 0;
  }
  .quote-{{ section.id }} .quote__role {
    display: block;
    margin: 0.4rem 0 0;
    opacity: 0.75;
  }
{%- endstyle -%}

<div class="quote-{{ section.id }} color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="section-{{ section.id }}-padding page-width">
    <blockquote class="quote__inner{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.show_quote_mark -%}
        <span class="quote__mark" aria-hidden="true">&ldquo;</span>
      {%- endif -%}

      <p class="quote__text {{ section.settings.quote_size }}">{{ section.settings.quote }}</p>

      {%- if section.settings.author != blank or section.settings.role != blank -%}
        <footer class="quote__attribution">
          <hr class="quote__attribution-rule" aria-hidden="true">
          {%- if section.settings.author != blank -%}
            <cite class="quote__author caption-with-letter-spacing">{{ section.settings.author | escape }}</cite>
          {%- endif -%}
          {%- if section.settings.role != blank -%}
            <span class="quote__role caption">{{ section.settings.role | escape }}</span>
          {%- endif -%}
        </footer>
      {%- endif -%}
    </blockquote>
  </div>
</div>

{% schema %}
{
  "name": "Brand Quote",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "quote",
      "default": "Skincare shouldn't take a chemistry degree to understand — or twelve steps to work.",
      "label": "Quote"
    },
    {
      "type": "select",
      "id": "quote_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Quote size"
    },
    {
      "type": "checkbox",
      "id": "show_quote_mark",
      "default": true,
      "label": "Show decorative quotation mark"
    },
    {
      "type": "text",
      "id": "author",
      "default": "The Thessvane Team",
      "label": "Attribution"
    },
    {
      "type": "text",
      "id": "role",
      "default": "Founders",
      "label": "Attribution detail"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 40,
      "max": 100,
      "step": 4,
      "unit": "rem",
      "label": "Quote width",
      "default": 72
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Brand Quote"
    }
  ]
}
{% endschema %}
