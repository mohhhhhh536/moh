{{ 'section-thessvane-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign focal_x = section.settings.image_focal_x | default: 68
  assign focal_y = section.settings.image_focal_y | default: 38
-%}

{%- style -%}
  #ThessvaneHero-{{ section.id }} {
    --hero-focal-position: {{ focal_x }}% {{ focal_y }}%;
    --hero-height: {{ section.settings.section_height }}vh;
  }
{%- endstyle -%}

<section
  id="ThessvaneHero-{{ section.id }}"
  class="thessvane-hero color-{{ section.settings.color_scheme }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="thessvane-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          class: 'thessvane-hero__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
          fetchpriority: 'high',
          loading: 'eager',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      {{
        'thessvane-hero-photo.jpg'
        | asset_url
        | image_tag:
          class: 'thessvane-hero__image',
          sizes: '100vw',
          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000',
          fetchpriority: 'high',
          loading: 'eager'
      }}
    {%- endif -%}
    <div class="thessvane-hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="thessvane-hero__inner page-width">
    <div class="thessvane-hero__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="thessvane-hero__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h1 class="thessvane-hero__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading }}
            </h1>
          {%- when 'text' -%}
            <div class="thessvane-hero__text rte" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div class="thessvane-hero__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="thessvane-hero__btn thessvane-hero__btn--primary"
                >
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="thessvane-hero__btn thessvane-hero__btn--secondary"
                >
                  {{- block.settings.button_label_2 | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- when 'trust_row' -%}
            <ul class="thessvane-hero__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank -%}<li>{{ block.settings.item_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.item_2 != blank -%}<li>{{ block.settings.item_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.item_3 != blank -%}<li>{{ block.settings.item_3 | escape }}</li>{%- endif -%}
            </ul>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Thessvane Hero",
  "tag": "section",
  "class": "section thessvane-hero-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses assets/thessvane-hero-photo.jpg until you pick a different image here."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "image_focal_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Image focal point (horizontal)",
      "default": 68
    },
    {
      "type": "range",
      "id": "image_focal_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Image focal point (vertical)",
      "default": 38
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 55,
      "max": 95,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 88
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Modern Skin Ritual",
          "label": "Text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Your Modern Skin Ritual",
          "label": "Heading"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            { "value": "h2", "label": "Small" },
            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" },
            { "value": "hxl", "label": "Extra large" }
          ],
          "default": "hxl",
          "label": "Heading size"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Clean, natural ingredients thoughtfully formulated for radiant, healthy skin — no complicated routine required.",
          "label": "Text"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label_1",
          "default": "Shop Now",
          "label": "First button label"
        },
        {
          "type": "url",
          "id": "button_link_1",
          "label": "First button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "default": "Our Ritual",
          "label": "Second button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Second button link"
        }
      ]
    },
    {
      "type": "trust_row",
      "name": "Trust row",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "item_1",
          "default": "Cruelty-Free",
          "label": "Item 1"
        },
        {
          "type": "text",
          "id": "item_2",
          "default": "Dermatologist Tested",
          "label": "Item 2"
        },
        {
          "type": "text",
          "id": "item_3",
          "default": "Clean Ingredients",
          "label": "Item 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thessvane Hero",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" },
        { "type": "trust_row" }
      ]
    }
  ]
}
{% endschema %}
