{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .ingredients-{{ section.id }} .ingredients__list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: 28px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media screen and (min-width: 750px) {
    .ingredients-{{ section.id }} .ingredients__list {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
      gap: 40px 28px;
    }
  }
  .ingredients-{{ section.id }} .ingredients__item {
    text-align: {{ section.settings.content_alignment }};
  }
  .ingredients-{{ section.id }} .ingredients__media {
    position: relative;
    {%- comment -%} Clipping comes from global-media-settings--no-shadow; base.css forces overflow:visible otherwise. {%- endcomment -%}
    overflow: hidden;
    margin-bottom: 16px;
    background-color: rgba(var(--color-foreground), 0.04);
  }
  .ingredients-{{ section.id }} .ingredients__media img,
  .ingredients-{{ section.id }} .ingredients__media .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ingredients-{{ section.id }} .ingredients__media--circle {
    border-radius: 50%;
    aspect-ratio: 1 / 1;
    max-width: 200px;
    margin-left: {% if section.settings.content_alignment == 'center' %}auto{% else %}0{% endif %};
    margin-right: {% if section.settings.content_alignment == 'center' %}auto{% else %}auto{% endif %};
  }
  .ingredients-{{ section.id }} .ingredients__media--square {
    aspect-ratio: 1 / 1;
    border-radius: var(--media-radius, 0);
  }
  .ingredients-{{ section.id }} .ingredients__media--portrait {
    aspect-ratio: 3 / 4;
    border-radius: var(--media-radius, 0);
  }
  .ingredients-{{ section.id }} .ingredients__name {
    margin: 0 0 4px;
  }
  .ingredients-{{ section.id }} .ingredients__latin {
    margin: 0 0 8px;
    font-size: 1.3rem;
    font-style: italic;
    opacity: 0.7;
  }
  .ingredients-{{ section.id }} .ingredients__badge {
    display: inline-block;
    margin: 0 0 10px;
    padding: 3px 12px;
    border: 0.1rem solid rgba(var(--color-foreground), 0.25);
    border-radius: 999px;
    font-size: 1.1rem;
    letter-spacing: 0.06rem;
    text-transform: uppercase;
  }
  .ingredients-{{ section.id }} .ingredients__text {
    margin: 0;
    font-size: 1.4rem;
  }
  .ingredients-{{ section.id }} .ingredients__free-from {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 0.1rem solid rgba(var(--color-foreground), 0.15);
    text-align: center;
  }
  .ingredients-{{ section.id }} .ingredients__free-from-title {
    margin: 0 0 14px;
    font-size: 1.2rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .ingredients-{{ section.id }} .ingredients__free-from-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ingredients-{{ section.id }} .ingredients__free-from-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 1.4rem;
  }
  .ingredients-{{ section.id }} .ingredients__free-from-item svg {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
    opacity: 0.6;
  }
  .ingredients-{{ section.id }} .ingredients__footer {
    margin-top: 32px;
    text-align: center;
  }
  .ingredients-{{ section.id }} .ingredients__disclaimer {
    margin: 0 auto;
    max-width: 70ch;
    font-size: 1.3rem;
    opacity: 0.75;
  }
{%- endstyle -%}

<div class="ingredients-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="section-{{ section.id }}-padding page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank or section.settings.description != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="subtitle rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="ingredients__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient' -%}
          <li class="ingredients__item" {{ block.shopify_attributes }}>
            {%- if section.settings.show_images -%}
              <div class="ingredients__media ingredients__media--{{ section.settings.image_shape }} global-media-settings global-media-settings--no-shadow">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) calc(100vw / ' | append: section.settings.columns_desktop | append: '), 50vw',
                      widths: '160, 240, 320, 480, 640, 800',
                      alt: block.settings.name
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.name != blank -%}
              <h3 class="ingredients__name h5">{{ block.settings.name | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.latin_name != blank -%}
              <p class="ingredients__latin">{{ block.settings.latin_name | escape }}</p>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <p class="ingredients__badge">{{ block.settings.badge | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ingredients__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if section.settings.show_free_from and section.settings.free_from_items != blank -%}
      <div class="ingredients__free-from">
        {%- if section.settings.free_from_title != blank -%}
          <p class="ingredients__free-from-title">{{ section.settings.free_from_title | escape }}</p>
        {%- endif -%}
        <ul class="ingredients__free-from-list" role="list">
          {%- assign free_from = section.settings.free_from_items | split: ',' -%}
          {%- for item in free_from -%}
            {%- assign item_label = item | strip -%}
            {%- if item_label != blank -%}
              <li class="ingredients__free-from-item">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
                  <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                {{ item_label }}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank or section.settings.button_label != blank -%}
      <div class="ingredients__footer">
        {%- if section.settings.disclaimer != blank -%}
          <p class="ingredients__disclaimer">{{ section.settings.disclaimer | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.button_link }}"
            {% endif %}
            class="button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            style="margin-top: 20px;"
          >
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each ingredient block shows a placeholder image until you pick one."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "What's Inside",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Every Ingredient, Explained",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Naturally derived actives, chosen for what they do — not for how they read on a label.</p>",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "default": true,
      "label": "Show ingredient images"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "circle",
      "label": "Image shape"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center",
      "label": "Content alignment"
    },
    {
      "type": "header",
      "content": "Free-from list"
    },
    {
      "type": "checkbox",
      "id": "show_free_from",
      "default": true,
      "label": "Show free-from list"
    },
    {
      "type": "text",
      "id": "free_from_title",
      "default": "Always Free From",
      "label": "Free-from heading"
    },
    {
      "type": "text",
      "id": "free_from_items",
      "default": "Parabens, Sulfates, Synthetic Fragrance, Mineral Oil, Silicones",
      "info": "Separate each item with a comma.",
      "label": "Free-from items"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "default": "Full INCI list is printed on every carton and shown under Ingredients on the product page.",
      "label": "Disclaimer text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": true,
      "label": "Use outline button style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "default": "Ingredient name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "latin_name",
          "label": "Latin / INCI name"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "info": "Short label such as a concentration or origin."
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Say what this ingredient does for skin in one short sentence.</p>",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Aloe Vera",
            "latin_name": "Aloe barbadensis",
            "badge": "Soothing",
            "text": "<p>Calms visible redness and keeps skin comfortable after cleansing.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Niacinamide",
            "latin_name": "Vitamin B3",
            "badge": "5%",
            "text": "<p>Evens tone and helps refine the look of enlarged pores over time.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Squalane",
            "latin_name": "Olive-derived",
            "badge": "Barrier support",
            "text": "<p>A weightless moisturiser that locks in hydration without any grease.</p>"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Green Tea",
            "latin_name": "Camellia sinensis",
            "badge": "Antioxidant",
            "text": "<p>Defends against the daily pollution and light stress that dull skin.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
