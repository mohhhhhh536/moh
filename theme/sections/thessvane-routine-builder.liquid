{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .routine-{{ section.id }} .routine__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    counter-reset: routine-step;
  }
  .routine-{{ section.id }} .routine__step {
    position: relative;
    padding-top: 8px;
  }
  .routine-{{ section.id }} .routine__step-index {
    counter-increment: routine-step;
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    line-height: 1;
    opacity: 0.35;
    margin: 0 0 4px;
  }
  .routine-{{ section.id }} .routine__step-index::before {
    content: counter(routine-step, decimal-leading-zero);
  }
  .routine-{{ section.id }} .routine__step-title {
    margin: 0 0 8px;
  }
  .routine-{{ section.id }} .routine__step-text {
    margin: 0 0 20px;
    max-width: 40ch;
  }
  .routine-{{ section.id }} .routine__step-card {
    max-width: 220px;
  }
  .routine-{{ section.id }} .routine__cta {
    margin-top: 44px;
    text-align: center;
  }
{%- endstyle -%}

<div class="routine-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding page-width">
    <div class="collection__title title-wrapper title-wrapper--no-top-margin">
      {%- if section.settings.title != blank -%}
        <h2 class="title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="collection__description subtitle rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>

    <div class="routine__steps">
      {%- for block in section.blocks -%}
        {%- if block.type == 'step' -%}
          <div class="routine__step" {{ block.shopify_attributes }}>
            <p class="routine__step-index"></p>
            <h3 class="routine__step-title h4">{{ block.settings.step_title | escape }}</h3>
            {%- if block.settings.step_text != blank -%}
              <div class="routine__step-text rte">{{ block.settings.step_text }}</div>
            {%- endif -%}
            <div class="routine__step-card">
              {% render 'card-product',
                card_product: block.settings.product,
                media_aspect_ratio: 'square',
                show_vendor: false,
                section_id: section.id
              %}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
      <div class="routine__cta">
        <a
          {% if section.settings.cta_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.cta_link }}"{% endif %}
          class="button"
        >
          {{- section.settings.cta_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Routine Builder",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each step's product card shows a placeholder until you assign a real product to that step block."
    },
    {
      "type": "text",
      "id": "title",
      "default": "Build Your Ritual",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Three simple steps to clean, radiant skin — mix and match to build a routine that fits you.</p>",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-2",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "default": true,
      "label": "Show button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "default": "Shop the Full Ritual",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "default": "/collections/all",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "step_title",
          "default": "Prep Your Skin",
          "label": "Step title"
        },
        {
          "type": "richtext",
          "id": "step_text",
          "default": "<p>Cleanse and prime with a gentle, natural formula.</p>",
          "label": "Step description"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine Builder",
      "blocks": [
        { "type": "step", "settings": { "step_title": "Prep Your Skin" } },
        { "type": "step", "settings": { "step_title": "Treat & Nourish" } },
        { "type": "step", "settings": { "step_title": "Lock the Glow" } }
      ]
    }
  ]
}
{% endschema %}
