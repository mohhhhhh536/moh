{{ 'section-thessvane-ingredient-callout.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="thessvane-ingredient color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="thessvane-ingredient__inner page-width">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="thessvane-ingredient__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- when 'heading' -%}
          <h2 class="thessvane-ingredient__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="thessvane-ingredient__text rte" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- assign tag_blocks = section.blocks | where: 'type', 'tag' -%}
    {%- if tag_blocks.size > 0 -%}
      <div class="thessvane-ingredient__tags">
        {%- for block in tag_blocks -%}
          <span class="thessvane-ingredient__tag" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            {{- block.settings.label | escape -}}
          </span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'button' and block.settings.label != blank -%}
        <a
          {% if block.settings.link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ block.settings.link }}"
          {% endif %}
          class="thessvane-ingredient__btn"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label | escape -}}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Thessvane Ingredient Callout",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 104
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 104
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Why Clean Ingredients",
          "label": "Text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Nothing Hidden. Nothing Harsh.",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Every Thessvane formula starts with naturally derived ingredients and skips the fillers common in mass-market skincare. Clean doesn't mean compromise — it means a routine you can trust, morning and night.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "tag",
      "name": "Excluded ingredient tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "No Sulfates",
          "label": "Label"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Our Ingredients",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thessvane Ingredient Callout",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "tag", "settings": { "label": "No Sulfates" } },
        { "type": "tag", "settings": { "label": "No Parabens" } },
        { "type": "tag", "settings": { "label": "No Synthetic Fragrance" } },
        { "type": "tag", "settings": { "label": "No Animal Testing" } },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
