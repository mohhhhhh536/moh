{{ 'component-rte.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .htu-{{ section.id }} {
    --htu-pill-bg: {{ section.settings.pill_background }};
    --htu-pill-text: {{ section.settings.pill_text_color }};
  }

  .htu-{{ section.id }} .htu__intro {
    text-align: center;
    margin-bottom: 32px;
  }
  .htu-{{ section.id }} .htu__title { margin: 0 0 8px; }
  .htu-{{ section.id }} .htu__description {
    margin: 0 auto;
    max-width: 62ch;
  }

  .htu-{{ section.id }} .htu__steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3px;
    counter-reset: htu-step;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media screen and (min-width: 750px) {
    .htu-{{ section.id }} .htu__steps {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }

  .htu-{{ section.id }} .htu__step {
    counter-increment: htu-step;
    display: flex;
    flex-direction: column;
    text-align: {{ section.settings.text_alignment }};
  }

  .htu-{{ section.id }} .htu__text {
    padding: 20px 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.text_alignment == 'center' %}center{% else %}flex-start{% endif %};
  }

  .htu-{{ section.id }} .htu__pill {
    display: inline-block;
    margin: 0 0 10px;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--htu-pill-bg);
    color: var(--htu-pill-text);
    font-family: var(--font-heading-family);
    font-size: 1.7rem;
    line-height: 1.3;
  }

  .htu-{{ section.id }} .htu__step-text {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.5;
  }
  .htu-{{ section.id }} .htu__step-text p { margin: 0; }

  .htu-{{ section.id }} .htu__divider {
    width: 56px;
    border: none;
    border-top: 1px solid var(--htu-pill-text);
    opacity: 0.4;
    margin: 14px 0 10px;
  }

  .htu-{{ section.id }} .htu__tagline {
    margin: 0;
    font-size: 1.3rem;
    color: var(--htu-pill-text);
  }

  .htu-{{ section.id }} .htu__frame {
    position: relative;
    aspect-ratio: {{ section.settings.image_ratio }};
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
  }
  .htu-{{ section.id }} .htu__frame img,
  .htu-{{ section.id }} .htu__frame .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .htu-{{ section.id }} .htu__frame .placeholder-svg {
    background: rgba(var(--color-foreground), 0.04);
    fill: rgba(var(--color-foreground), 0.28);
  }

  .htu-{{ section.id }} .htu__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.18);
  }
  .htu-{{ section.id }} .htu__badge::before {
    content: counter(htu-step);
  }

  .htu-{{ section.id }} .htu__note {
    margin: 28px auto 0;
    max-width: 70ch;
    text-align: center;
    font-size: 1.3rem;
    opacity: 0.7;
  }
  .htu-{{ section.id }} .htu__note p { margin: 0; }
  .htu-{{ section.id }} .htu__cta { margin-top: 32px; text-align: center; }
{%- endstyle -%}

<div class="htu-{{ section.id }} color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="section-{{ section.id }}-padding page-width">
    {%- if section.settings.title != blank or section.settings.description != blank -%}
      <div class="htu__intro">
        {%- if section.settings.title != blank -%}
          <h2 class="htu__title title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="htu__description subtitle rte">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="htu__steps">
      {%- for block in section.blocks -%}
        {%- assign step_alt = block.settings.image.alt | default: block.settings.step_title -%}
        <li class="htu__step" {{ block.shopify_attributes }}>
          <div class="htu__text">
            {%- if block.settings.step_title != blank -%}
              <span class="htu__pill">{{ block.settings.step_title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.step_text != blank -%}
              <div class="htu__step-text rte">{{ block.settings.step_text }}</div>
            {%- endif -%}
            {%- if block.settings.step_tagline != blank -%}
              <hr class="htu__divider">
              <p class="htu__tagline">{{ block.settings.step_tagline | escape }}</p>
            {%- endif -%}
          </div>

          <div class="htu__frame">
            {%- if section.settings.show_step_numbers -%}
              <span class="htu__badge" aria-hidden="true"></span>
            {%- endif -%}
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw',
                  widths: '200, 300, 400, 600, 900',
                  alt: step_alt
              }}
            {%- else -%}
              {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' -}}
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.footnote != blank -%}
      <div class="htu__note rte">{{ section.settings.footnote }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="htu__cta">
        <a
          {% if section.settings.cta_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.cta_link }}"
          {% endif %}
          class="button"
        >
          {{- section.settings.cta_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Skin Benefits Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "A row of product benefits, each with a photo. Cards without an uploaded photo show a placeholder graphic, so you can publish the copy now and add real photography later — do not substitute AI-generated “model” photography here without disclosing it, since a photo in this slot reads as a real product/customer shot."
    },
    {
      "type": "text",
      "id": "title",
      "default": "What It Does For Your Skin",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Four benefits, one bottle. Here's what changes when it becomes part of your routine.</p>",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-5",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "pill_background",
      "label": "Pill background",
      "default": "#F6D8DE"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Pill text and tagline color",
      "default": "#8B3A55"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Cards per row on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall portrait" },
        { "value": "9 / 16", "label": "Vertical video" }
      ],
      "default": "4 / 5",
      "label": "Photo shape"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left",
      "label": "Text alignment"
    },
    {
      "type": "checkbox",
      "id": "show_step_numbers",
      "default": false,
      "label": "Show numbered badges on photos",
      "info": "Turn on if you'd rather present these as ordered steps than as benefits."
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Side note",
      "info": "Small print under the cards. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "step_title",
          "default": "Benefit name",
          "label": "Benefit name",
          "info": "Shown in the pill above the description, e.g. \"Cleanses\"."
        },
        {
          "type": "richtext",
          "id": "step_text",
          "default": "<p>Describe this benefit in one short sentence.</p>",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "step_tagline",
          "label": "Tagline",
          "info": "A short line under the divider, e.g. \"Clean skin, undisturbed barrier.\" Leave blank to hide."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skin Benefits Grid",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
