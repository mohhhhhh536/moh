{{ 'section-thessvane-our-story.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  class="thessvane-story color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="thessvane-story__inner page-width{% if section.settings.image_position == 'right' %} thessvane-story__inner--reverse{% endif %}">
    <div class="thessvane-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'thessvane-story__image',
            sizes: '(min-width: 860px) 42vw, 90vw',
            widths: '400, 600, 800, 1100, 1600',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{
          'thessvane-story-photo.jpg'
          | asset_url
          | image_tag:
            class: 'thessvane-story__image',
            sizes: '(min-width: 860px) 42vw, 90vw',
            widths: '400, 600, 800, 1100, 1600',
            loading: 'lazy'
        }}
      {%- endif -%}
    </div>
    <div class="thessvane-story__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="thessvane-story__eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="thessvane-story__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'text' -%}
            <div class="thessvane-story__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'signature' -%}
            <div class="thessvane-story__signature" {{ block.shopify_attributes }}>
              <span class="thessvane-story__mark" aria-hidden="true"></span>
              <span>
                <strong>{{ block.settings.title | escape }}</strong>
                {{ block.settings.text | escape }}
              </span>
            </div>
          {%- when 'button' -%}
            {%- if block.settings.label != blank -%}
              <a
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="thessvane-story__btn"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | escape -}}
              </a>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Thessvane Our Story",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses assets/thessvane-story-photo.jpg until you pick a different image here."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Image position (desktop)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Our Story",
          "label": "Text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Founded On A Simple Idea",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Thessvane started with a simple frustration: skincare shouldn't require a chemistry degree to understand.</p><p>We formulate with naturally derived ingredients, skip the synthetic filler, and keep every routine simple enough to actually stick to — a small, deliberate ritual instead of a twelve-step regimen.</p>",
          "label": "Text"
        }
      ]
    },
    {
      "type": "signature",
      "name": "Signature line",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Small-Batch, Thoughtfully Made",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Every formula is developed in small batches and tested for how it feels on skin, not just how it looks on a label.",
          "label": "Text"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "default": "Learn More",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Thessvane Our Story",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "signature" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
